# Copy to .env and fill in before the first deploy.

# Umbraco backoffice admin (created on first boot only; changing these later
# has no effect on an existing install).
UMBRACO_ADMIN_NAME=Administrator
UMBRACO_ADMIN_EMAIL=wesley@scriptonic.nl
UMBRACO_ADMIN_PASSWORD=

# Key for the /admin/berichten overview (visit /admin/berichten?key=<value>).
SITE_ADMIN_KEY=

# e-Boekhouden API token. Leave empty on acceptance: the portal then runs in
# demo mode (sample invoices + demo member demo@scriptonic.nl / DemoKlant123!).
EBOEKHOUDEN_API_TOKEN=

# Optional: Scriptonic Analytics tracker script URL.
ANALYTICS_SCRIPT_URL=
