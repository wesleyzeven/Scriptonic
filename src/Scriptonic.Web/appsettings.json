{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite",
    "siteDbDSN": "Data Source=|DataDirectory|/Site.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True"
  },
  "Site": {
    "SiteName": "Scriptonic",
    "PublicBaseUrl": "https://scriptonic.local.io",
    "Eboekhouden": {
      "BaseUrl": "https://api.e-boekhouden.nl",
      "Source": "Scriptonic"
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "6474d1be-fa2f-4a58-a481-2a2678708353"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false,
        "MemberDefaultLockoutTimeInMinutes": 15
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Imaging": {
        "HMACSecretKey": "7AKzB/iqXTe623HHJI8jHPCYxxjEYBoa4Nue9VrygFidWsUSWFPMoVQYqb1zS1mmGBMZtAyIvPtfflK/zHYPgQ=="
      }
    }
  }
}
