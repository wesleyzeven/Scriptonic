<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting configuration for the Qweb/Plesk production server.
  `dotnet publish` fills in %LAUNCHER_PATH% / %LAUNCHER_ARGS% for the
  self-contained win-x64 build; the deploy workflow replaces __APP_VERSION__.
  Secrets do NOT belong here: they live in secrets.json next to this file on
  the server (see deploy/qweb/secrets.example.json).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\umbraco\Logs\stdout"
                  hostingModel="inprocess"
                  startupTimeLimit="300"
                  requestTimeout="00:05:00">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="Site__AppVersion" value="__APP_VERSION__" />
          <environmentVariable name="Site__PublicBaseUrl" value="https://scriptonic.nl" />
          <environmentVariable name="Umbraco__CMS__WebRouting__UmbracoApplicationUrl" value="https://scriptonic.nl" />
          <environmentVariable name="Umbraco__CMS__Global__UseHttps" value="true" />
          <environmentVariable name="Umbraco__CMS__Unattended__InstallUnattended" value="true" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
