@model PortalLoginModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Inloggen klantportaal";
    ViewData["MetaDescription"] = "Log in op het Scriptonic klantportaal om je facturen, offertes en gegevens in te zien.";
}

<section class="mx-auto max-w-md px-4 py-20">
    <p class="braced text-center font-brand text-sm font-bold text-steel-dark">klantportaal</p>
    <h1 class="mt-2 text-center text-3xl">Inloggen</h1>
    <p class="mt-3 text-center text-sm text-ink-soft">
        Bekijk je facturen en offertes en beheer je gegevens.
    </p>

    <form method="post" action="/portaal/login" class="card mt-8 space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="rounded-md border border-red-300 bg-red-50 p-3 text-sm text-red-700">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <div>
            <label class="label" for="p-email">E-mailadres</label>
            <input class="input" id="p-email" name="Email" type="email" value="@Model.Email" required autofocus autocomplete="username" />
        </div>
        <div>
            <label class="label" for="p-password">Wachtwoord</label>
            <input class="input" id="p-password" name="Password" type="password" required autocomplete="current-password" />
        </div>
        <button type="submit" class="btn-primary w-full">Inloggen</button>
        <p class="text-center text-xs text-ink-soft">
            Nog geen toegang of wachtwoord kwijt? <a class="text-steel-dark underline" href="/contact/">Neem contact op</a> — we helpen je direct.
        </p>
    </form>
</section>
