@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Offertes";
    var offertes = ViewData["Offertes"] as IReadOnlyList<OfferteInfo> ?? [];
    var nl = new System.Globalization.CultureInfo("nl-NL");
}

<partial name="~/Views/Portal/_PortalNav.cshtml" />

<section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl">Offertes</h1>
    <p class="mt-2 text-ink-soft">Uitgebrachte offertes voor je lopende en nieuwe projecten.</p>

    @if (offertes.Count == 0)
    {
        <div class="card mt-8 text-center text-ink-soft">Er staan momenteel geen offertes voor je klaar.</div>
    }
    else
    {
        <div class="mt-8 grid gap-6 md:grid-cols-2">
            @foreach (var offerte in offertes)
            {
                string statusClass = offerte.Status.Equals("Geaccepteerd", StringComparison.OrdinalIgnoreCase)
                    ? "bg-emerald-100 text-emerald-800"
                    : offerte.Status.Equals("Verlopen", StringComparison.OrdinalIgnoreCase)
                        ? "bg-gray-200 text-gray-600"
                        : "bg-amber-100 text-amber-800";
                <div class="card">
                    <div class="flex items-center justify-between gap-2">
                        <span class="font-brand text-sm font-bold text-steel-dark">@offerte.Number</span>
                        <span class="rounded px-2 py-0.5 font-brand text-xs font-bold @statusClass">@offerte.Status</span>
                    </div>
                    <h2 class="mt-3 text-lg">@offerte.Name</h2>
                    <p class="mt-2 text-sm leading-relaxed text-ink-soft">@offerte.Description</p>
                    <dl class="mt-4 grid grid-cols-3 gap-3 border-t border-line pt-4 text-sm">
                        <div>
                            <dt class="font-brand text-xs text-ink-soft">Datum</dt>
                            <dd>@(offerte.Date?.ToString("dd-MM-yyyy") ?? "—")</dd>
                        </div>
                        <div>
                            <dt class="font-brand text-xs text-ink-soft">Geldig tot</dt>
                            <dd>@(offerte.ValidUntil?.ToString("dd-MM-yyyy") ?? "—")</dd>
                        </div>
                        <div>
                            <dt class="font-brand text-xs text-ink-soft">Bedrag</dt>
                            <dd class="font-bold">@offerte.Amount.ToString("C", nl)</dd>
                        </div>
                    </dl>
                    <div class="mt-4 flex gap-3">
                        @if (!string.IsNullOrEmpty(offerte.PdfUrl))
                        {
                            <a class="btn-secondary px-4 py-2 text-sm" href="@offerte.PdfUrl" rel="noopener" target="_blank">Bekijk PDF</a>
                        }
                        <a class="btn-primary px-4 py-2 text-sm" href="mailto:info@scriptonic.nl?subject=Reactie op offerte @offerte.Number">Reageer op offerte</a>
                    </div>
                </div>
            }
        </div>
    }
</section>
