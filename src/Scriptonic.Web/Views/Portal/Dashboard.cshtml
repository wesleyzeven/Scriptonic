@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Klantportaal";
    var portalUser = (PortalUser)ViewData["PortalUser"]!;
    var outstanding = ViewData["Outstanding"] as IReadOnlyList<EboekOutstandingInvoice> ?? [];
    var invoices = ViewData["Invoices"] as IReadOnlyList<EboekInvoice> ?? [];
    var offertes = ViewData["Offertes"] as IReadOnlyList<IPublishedContent> ?? [];
    decimal openTotal = outstanding.Sum(o => o.OutstandingAmount ?? 0);
}

<partial name="~/Views/Portal/_PortalNav.cshtml" />

<section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl">Welkom, @portalUser.CompanyName</h1>
    <p class="mt-2 text-ink-soft">Hier vind je je facturen, offertes en gegevens op één plek.</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
        <div class="card">
            <p class="braced font-brand text-xs font-bold text-steel-dark">openstaand</p>
            <p class="mt-3 font-brand text-3xl font-bold">@openTotal.ToString("C", new System.Globalization.CultureInfo("nl-NL"))</p>
            <p class="mt-1 text-sm text-ink-soft">@outstanding.Count openstaande @(outstanding.Count == 1 ? "factuur" : "facturen")</p>
        </div>
        <a href="/portaal/facturen" class="card group">
            <p class="braced font-brand text-xs font-bold text-steel-dark">facturen</p>
            <p class="mt-3 font-brand text-3xl font-bold group-hover:text-steel-dark">@invoices.Count+</p>
            <p class="mt-1 text-sm text-ink-soft">Bekijk alle facturen →</p>
        </a>
        <a href="/portaal/offertes" class="card group">
            <p class="braced font-brand text-xs font-bold text-steel-dark">offertes</p>
            <p class="mt-3 font-brand text-3xl font-bold group-hover:text-steel-dark">@offertes.Count</p>
            <p class="mt-1 text-sm text-ink-soft">Bekijk je offertes →</p>
        </a>
    </div>

    @if (invoices.Count > 0)
    {
        <h2 class="mt-14 text-xl">Recente facturen</h2>
        <div class="card mt-4 overflow-x-auto p-0">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-line text-left font-brand text-xs text-ink-soft">
                        <th class="px-5 py-3">Factuur</th>
                        <th class="px-5 py-3">Datum</th>
                        <th class="px-5 py-3 text-right">Bedrag (incl. btw)</th>
                        <th class="px-5 py-3 text-right">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in invoices)
                    {
                        bool open = outstanding.Any(o => o.InvoiceNumber == invoice.InvoiceNumber);
                        <tr class="border-b border-line/60">
                            <td class="px-5 py-3 font-brand font-bold">@invoice.InvoiceNumber</td>
                            <td class="px-5 py-3">@invoice.Date?.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("nl-NL"))</td>
                            <td class="px-5 py-3 text-right">@((invoice.TotalIncludingVat ?? 0).ToString("C", new System.Globalization.CultureInfo("nl-NL")))</td>
                            <td class="px-5 py-3 text-right">
                                @if (open)
                                {
                                    <span class="rounded bg-amber-100 px-2 py-0.5 font-brand text-xs font-bold text-amber-800">Open</span>
                                }
                                else
                                {
                                    <span class="rounded bg-emerald-100 px-2 py-0.5 font-brand text-xs font-bold text-emerald-800">Voldaan</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
