@model Scriptonic.Web.ViewComponents.SiteHeaderModel
@{
    // data-top drives the bar/logo height in site.css. It is rendered
    // server-side so the first paint is already right (Alpine loads deferred),
    // after which Alpine keeps it in sync while scrolling. The two thresholds
    // give the toggle hysteresis, so a header that shrinks — and thereby
    // shortens the document — can't immediately flip back.
    string atTop = Model.Large ? "true" : "false";
}
<header class="site-header sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur"
        data-top="@atTop"
        x-data="{ open: false, grows: @atTop, atTop: @atTop }"
        x-bind:data-top="atTop.toString()"
        @@scroll.window="atTop = grows && window.scrollY < (atTop ? 32 : 8)">
    <div class="site-header-bar mx-auto flex max-w-6xl items-center justify-between gap-4 px-4">
        <a href="/" class="flex items-center gap-3">
            <img src="/img/logo.png" alt="Scriptonic" class="site-header-logo w-auto" />
        </a>

        <nav class="hidden items-center gap-6 font-brand text-sm font-bold md:flex">
            @foreach (var link in Model.Links)
            {
                <a class="text-ink-soft transition hover:text-steel-dark" href="@link.Url">@link.Name</a>
            }
            <a href="/portaal" class="rounded-md border-2 border-steel-dark px-4 py-1.5 text-steel-dark transition hover:bg-steel-dark hover:text-white">
                @(Model.IsLoggedIn ? "Mijn portaal" : "Klantportaal")
            </a>
        </nav>

        <button class="md:hidden" @@click="open = !open" aria-label="Menu">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
        </button>
    </div>

    <nav class="border-t border-line bg-paper px-4 py-3 md:hidden" x-show="open" x-cloak>
        <ul class="space-y-2 font-brand font-bold">
            @foreach (var link in Model.Links)
            {
                <li><a class="block py-1 text-ink-soft" href="@link.Url">@link.Name</a></li>
            }
            <li><a class="block py-1 text-steel-dark" href="/portaal">@(Model.IsLoggedIn ? "Mijn portaal" : "Klantportaal")</a></li>
        </ul>
    </nav>
</header>
