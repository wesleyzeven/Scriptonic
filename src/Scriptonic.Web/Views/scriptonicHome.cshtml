@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "";
    // Home opens with the oversized logo bar; it shrinks on scroll.
    ViewData["LargeHeader"] = true;
    ViewData["MetaDescription"] = Model.Value<string>("seoDescription");
    var diensten = Model.Children().FirstOrDefault(c => c.ContentType.Alias == SiteAliases.Diensten);
    var portfolio = Model.Children().FirstOrDefault(c => c.ContentType.Alias == SiteAliases.Portfolio);
    var contact = Model.Children().FirstOrDefault(c => c.ContentType.Alias == SiteAliases.Contact);
    string ctaLabel = Model.Value<string>("ctaLabel") ?? "Plan een kennismaking";
}

@* De hero vult het hele scherm onder de (grote) header, zodat het volgende
   blok pas bij scrollen in beeld komt. Hoogte staat in site.css (.hero). *@
<section class="hero relative flex overflow-hidden bg-ink text-white">
    <canvas id="hero-canvas" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div class="relative mx-auto flex w-full max-w-6xl flex-col justify-center px-4 py-24 sm:py-32">
        <p class="braced font-brand text-sm font-bold text-white/70">@(Model.Value<string>("tagline"))</p>
        <h1 class="mt-4 max-w-3xl text-4xl leading-tight sm:text-5xl">
            @(Model.Value<string>("heroTitle"))
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">
            @(Model.Value<string>("heroText"))
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
            @if (contact is not null)
            {
                <a href="@contact.Url()" class="btn-primary">@ctaLabel</a>
            }
            @if (portfolio is not null)
            {
                <a href="@portfolio.Url()" class="btn-light">Bekijk ons werk</a>
            }
        </div>
    </div>
</section>

@if (diensten is not null)
{
    <section class="mx-auto max-w-6xl px-4 py-20">
        <p class="braced font-brand text-sm font-bold text-steel-dark">diensten</p>
        <h2 class="mt-2 text-3xl">Wat we maken</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
            @foreach (var dienst in diensten.Children().Where(c => c.ContentType.Alias == SiteAliases.Dienst))
            {
                <a href="@dienst.Url()" class="card group">
                    <span class="text-3xl">@(dienst.Value<string>("icon"))</span>
                    <h3 class="mt-4 text-lg group-hover:text-steel-dark">@dienst.Name</h3>
                    <p class="mt-2 text-sm leading-relaxed text-ink-soft">@(dienst.Value<string>("summary"))</p>
                    <span class="mt-4 inline-block font-brand text-sm font-bold text-steel-dark">Lees meer →</span>
                </a>
            }
        </div>
    </section>
}

@if (portfolio is not null)
{
    <section class="relative overflow-hidden bg-steel-soft/60">
        @* Decoratieve haken, verticaal gecentreerd via flex (geen translate:
           GSAP schuift ze in motion.js met een eigen transform). *@
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 flex select-none items-center justify-between font-brand text-[18rem] font-bold leading-none text-steel/10">
            <span data-brace-l class="-ml-6 sm:-ml-2">{</span>
            <span data-brace-r class="-mr-6 sm:-mr-2">}</span>
        </div>
        <div class="relative mx-auto max-w-6xl px-4 py-20">
            <p class="braced font-brand text-sm font-bold text-steel-dark">portfolio</p>
            <h2 class="mt-2 text-3xl">Recent werk</h2>
            <div class="mt-10 grid gap-6 md:grid-cols-3">
                @foreach (var item in portfolio.Children().Where(c => c.ContentType.Alias == SiteAliases.Case).Take(3))
                {
                    <a href="@item.Url()" class="card group overflow-hidden">
                        <partial name="_CasePreview" model="item" />
                        <div class="flex items-center justify-between gap-2">
                            <span class="tag">@(item.Value<string>("projectType"))</span>
                            <span class="font-brand text-xs text-ink-soft">@(item.Value<string>("status"))</span>
                        </div>
                        <h3 class="mt-4 text-lg group-hover:text-steel-dark">@item.Name</h3>
                        <p class="mt-2 text-sm leading-relaxed text-ink-soft">@(item.Value<string>("summary"))</p>
                    </a>
                }
            </div>
            <a href="@portfolio.Url()" class="mt-8 inline-block font-brand font-bold text-steel-dark hover:text-steel-deep">Al ons werk →</a>
        </div>
    </section>
}

@if (contact is not null)
{
    <section class="bg-ink text-white">
        <div class="mx-auto max-w-6xl px-4 py-16 text-center">
            <h2 class="text-3xl">Iets moois bouwen<span class="text-steel">?</span></h2>
            <p class="mx-auto mt-4 max-w-xl text-white/75">Vertel ons wat je voor ogen hebt — we denken vrijblijvend mee.</p>
            <a href="@contact.Url()" class="btn-primary mt-8">@ctaLabel</a>
        </div>
    </section>
}

<section id="process" class="mx-auto max-w-6xl px-4 py-20">
    <p class="braced font-brand text-sm font-bold text-steel-dark">werkwijze</p>
    <h2 class="mt-2 text-3xl">Zo werkt het</h2>
    <div class="mt-10 gap-16 lg:grid lg:grid-cols-2">
        <div class="space-y-10 lg:space-y-0">
            <div data-step class="process-step lg:flex lg:min-h-[50vh] lg:flex-col lg:justify-center">
                <p class="font-brand text-4xl font-bold text-steel">01</p>
                <h3 class="mt-2 text-lg">Kennismaken &amp; plan</h3>
                <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-soft">We beginnen met een gratis gesprek. Daarna krijg je een helder voorstel: wat we bouwen, wat het kost en wanneer het er staat.</p>
            </div>
            <div data-step class="process-step lg:flex lg:min-h-[50vh] lg:flex-col lg:justify-center">
                <p class="font-brand text-4xl font-bold text-steel">02</p>
                <h3 class="mt-2 text-lg">Bouwen &amp; meekijken</h3>
                <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-soft">Je kijkt live mee op een acceptatieomgeving terwijl we bouwen. Feedback verwerken we direct — geen verrassingen bij oplevering.</p>
            </div>
            <div data-step class="process-step lg:flex lg:min-h-[50vh] lg:flex-col lg:justify-center">
                <p class="font-brand text-4xl font-bold text-steel">03</p>
                <h3 class="mt-2 text-lg">Live &amp; verder</h3>
                <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-soft">Na livegang blijven we aan boord: hosting, updates, back-ups en doorontwikkeling. Via het klantportaal volg je facturen en offertes.</p>
            </div>
        </div>
        <div class="hidden lg:block">
            <div class="sticky top-28 flex min-h-[50vh] items-center">
                <svg id="process-wireframe" viewBox="0 0 420 320" class="w-full" aria-hidden="true" fill="none">
                    <!-- Browser chrome -->
                    <g data-wf-outline>
                        <rect x="10" y="10" width="400" height="300" rx="10" stroke="#4f709a" stroke-width="2"/>
                        <line x1="10" y1="48" x2="410" y2="48" stroke="#4f709a" stroke-width="2"/>
                        <circle cx="32" cy="29" r="5" stroke="#6d8fb5" stroke-width="2"/>
                        <circle cx="50" cy="29" r="5" stroke="#6d8fb5" stroke-width="2"/>
                        <circle cx="68" cy="29" r="5" stroke="#6d8fb5" stroke-width="2"/>
                        <rect x="90" y="19" width="240" height="20" rx="6" stroke="#6d8fb5" stroke-width="1.5"/>
                    </g>
                    <!-- Dashed layout skeleton (stage 1: plan) -->
                    <g data-wf-outline stroke="#6d8fb5" stroke-width="1.5" stroke-dasharray="6 5">
                        <rect x="28" y="64" width="364" height="30" rx="4"/>
                        <rect x="28" y="106" width="364" height="80" rx="4"/>
                        <rect x="28" y="198" width="112" height="62" rx="4"/>
                        <rect x="154" y="198" width="112" height="62" rx="4"/>
                        <rect x="280" y="198" width="112" height="62" rx="4"/>
                        <rect x="28" y="272" width="364" height="24" rx="4"/>
                    </g>
                    <!-- Solid blocks (stage 2: build) -->
                    <g data-wf-fill>
                        <rect x="28" y="64" width="364" height="30" rx="4" fill="#eef2f7"/>
                        <rect x="40" y="73" width="52" height="12" rx="3" fill="#4f709a"/>
                        <rect x="300" y="73" width="80" height="12" rx="3" fill="#9db4cf"/>
                    </g>
                    <g data-wf-fill>
                        <rect x="28" y="106" width="364" height="80" rx="4" fill="#35516f"/>
                        <rect x="48" y="126" width="150" height="14" rx="3" fill="#fafaf8"/>
                        <rect x="48" y="148" width="200" height="8" rx="3" fill="#9db4cf"/>
                        <rect x="48" y="162" width="64" height="14" rx="4" fill="#6d8fb5"/>
                    </g>
                    <g data-wf-fill>
                        <rect x="28" y="198" width="112" height="62" rx="4" fill="#eef2f7"/>
                        <rect x="154" y="198" width="112" height="62" rx="4" fill="#eef2f7"/>
                        <rect x="280" y="198" width="112" height="62" rx="4" fill="#eef2f7"/>
                        <rect x="38" y="208" width="60" height="8" rx="3" fill="#6d8fb5"/>
                        <rect x="164" y="208" width="60" height="8" rx="3" fill="#6d8fb5"/>
                        <rect x="290" y="208" width="60" height="8" rx="3" fill="#6d8fb5"/>
                        <rect x="28" y="272" width="364" height="24" rx="4" fill="#16181d"/>
                    </g>
                    <!-- Live state (stage 3) -->
                    <g data-wf-live font-family="Courier Prime, Courier New, monospace">
                        <text x="102" y="33" font-size="12" fill="#4f709a">https://scriptonic.nl</text>
                        <circle data-wf-livedot cx="380" cy="29" r="5" fill="#34d399"/>
                        <text x="340" y="33" font-size="11" fill="#34d399">live</text>
                    </g>
                </svg>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script defer src="/js/hero-constellation.js" asp-append-version="true"></script>
}
