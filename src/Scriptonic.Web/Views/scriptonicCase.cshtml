@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Value<string>("seoTitle") is string st && !string.IsNullOrWhiteSpace(st) ? st : Model.Name;
    ViewData["MetaDescription"] = Seo.Description(Model, "seoDescription", "summary");
    string[] tags = (Model.Value<string>("tags") ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
    string? projectUrl = Model.Value<string>("projectUrl");

    // De voorbeeldfoto van de kaart wordt hier de grote kopfoto; extra foto's
    // uit "Foto's" vormen de galerij (de kopfoto telt daar niet dubbel in mee).
    IPublishedContent? hero = Model.FirstMedia("previewImage");
    var gallery = Model.MediaItems("images").Where(m => hero is null || m.Id != hero.Id).ToList();
    if (hero is null && gallery.Count > 0)
    {
        hero = gallery[0];
        gallery.RemoveAt(0);
    }
    if (hero is not null)
    {
        // Share previews (Open Graph) get a 1200x630 crop of the same photo.
        ViewData["OgImage"] = hero.GetCropUrl(width: 1200, height: 630, quality: 85);
    }
}

<section class="mx-auto max-w-3xl px-4 py-16">
    <nav aria-label="Kruimelpad">
        <a class="braced font-brand text-sm font-bold text-steel-dark hover:text-steel-deep" href="@(Model.Parent()?.Url() ?? "/portfolio/")">portfolio</a>
    </nav>
    <h1 class="mt-2 text-4xl">@Model.Name</h1>

    @if (hero is not null)
    {
        @* Largest element above the fold: eager + high priority, served as
           responsive WebP crops instead of the original upload. *@
        <figure class="mt-8 overflow-hidden rounded-lg border border-line bg-white shadow-card">
            <img src="@Seo.Crop(hero, 1280, 16, 10)"
                 srcset="@Seo.Srcset(hero, 16, 10, 640, 960, 1280, 1600)"
                 sizes="(min-width: 800px) 768px, 100vw"
                 width="1280" height="800"
                 alt="@(Model.Value<string>("projectType")) @Model.Name — schermafdruk"
                 fetchpriority="high" decoding="async"
                 class="aspect-16/10 w-full object-cover" />
        </figure>
    }

    <dl class="mt-6 grid grid-cols-2 gap-4 rounded-lg border border-line bg-white p-5 text-sm sm:grid-cols-4">
        <div>
            <dt class="font-brand text-xs font-bold text-ink-soft">Opdrachtgever</dt>
            <dd class="mt-1">@(Model.Value<string>("client"))</dd>
        </div>
        <div>
            <dt class="font-brand text-xs font-bold text-ink-soft">Soort</dt>
            <dd class="mt-1">@(Model.Value<string>("projectType"))</dd>
        </div>
        <div>
            <dt class="font-brand text-xs font-bold text-ink-soft">Status</dt>
            <dd class="mt-1">@(Model.Value<string>("status"))</dd>
        </div>
        @if (!string.IsNullOrEmpty(projectUrl))
        {
            <div>
                <dt class="font-brand text-xs font-bold text-ink-soft">Bekijk</dt>
                <dd class="mt-1"><a class="text-steel-dark underline" href="@projectUrl" rel="noopener" target="_blank">Live site</a></dd>
            </div>
        }
    </dl>

    <p class="mt-8 text-lg text-ink-soft">@(Model.Value<string>("summary"))</p>

    <div class="prose-block mt-6">
        <partial name="_Paragraphs" model="@(Model.Value<string>("bodyText"))" />
    </div>

    @if (gallery.Count > 0)
    {
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
            @foreach (var image in gallery)
            {
                <figure class="overflow-hidden rounded-lg border border-line bg-white shadow-card">
                    <img src="@Seo.Crop(image, 800, 16, 10)"
                         srcset="@Seo.Srcset(image, 16, 10, 480, 800, 1200)"
                         sizes="(min-width: 640px) 376px, 100vw"
                         width="800" height="500"
                         alt="@Model.Name — @(image.Name)" loading="lazy" decoding="async"
                         class="aspect-16/10 w-full object-cover" />
                </figure>
            }
        </div>
    }

    @if (tags.Length > 0)
    {
        <div class="mt-8 flex flex-wrap gap-2">
            @foreach (string tag in tags)
            {
                <span class="tag">@tag.Trim()</span>
            }
        </div>
    }

    <div class="mt-12 rounded-lg bg-steel-soft p-8 text-center">
        <h2 class="text-xl">Zoiets ook nodig?</h2>
        <p class="mt-2 text-ink-soft">We vertellen je graag hoe we dit aanpakken voor jouw project.</p>
        <a href="/contact/" class="btn-primary mt-6">Neem contact op</a>
    </div>
</section>