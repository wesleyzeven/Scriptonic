@model List<ContactMessage>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Contactberichten";
    string key = ViewData["AdminKey"] as string ?? "";
}

<section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl">Contactberichten</h1>
    <p class="mt-2 text-ink-soft">@Model.Count bericht(en), nieuwste eerst.</p>

    <div class="mt-8 space-y-4">
        @foreach (var message in Model)
        {
            <div class="card @(message.Handled ? "opacity-60" : "")">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="font-brand text-sm font-bold">
                        @message.Name
                        <span class="font-normal text-ink-soft">&lt;@message.Email&gt;</span>
                        @if (!string.IsNullOrEmpty(message.Company))
                        {
                            <span class="text-ink-soft">· @message.Company</span>
                        }
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="tag">@message.Subject</span>
                        <span class="font-brand text-xs text-ink-soft">@message.CreatedUtc.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span>
                    </div>
                </div>
                <p class="mt-3 whitespace-pre-line text-sm text-ink-soft">@message.Message</p>
                <form method="post" action="/admin/berichten/@message.Id/afgehandeld?key=@key" class="mt-4">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="font-brand text-xs font-bold text-steel-dark underline">
                        @(message.Handled ? "Markeer als open" : "Markeer als afgehandeld")
                    </button>
                </form>
            </div>
        }
    </div>
</section>
