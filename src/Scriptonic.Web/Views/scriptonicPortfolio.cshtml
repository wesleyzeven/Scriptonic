@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Value<string>("seoTitle") ?? Model.Name;
    ViewData["MetaDescription"] = Model.Value<string>("seoDescription");
}

<section class="mx-auto max-w-6xl px-4 py-16">
    <p class="braced font-brand text-sm font-bold text-steel-dark">portfolio</p>
    <h1 class="mt-2 text-4xl">@Model.Name</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">@(Model.Value<string>("intro"))</p>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
        @foreach (var item in Model.Children().Where(c => c.ContentType.Alias == SiteAliases.Case))
        {
            <a href="@item.Url()" class="card group">
                <div class="flex items-center justify-between gap-2">
                    <span class="tag">@(item.Value<string>("projectType"))</span>
                    <span class="font-brand text-xs text-ink-soft">@(item.Value<string>("status"))</span>
                </div>
                <h2 class="mt-4 text-xl group-hover:text-steel-dark">@item.Name</h2>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">@(item.Value<string>("summary"))</p>
                <span class="mt-4 inline-block font-brand text-sm font-bold text-steel-dark">Bekijk case →</span>
            </a>
        }
    </div>
</section>